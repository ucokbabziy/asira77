  transform:rotate(25deg);
  transition:.7s;
}

/* HOVER GOLD GLOW */
.btn-daftar:hover{
  transform:translateY(-3px) scale(1.05);

  background:
    linear-gradient(
      135deg,
      #052766 0%,
      #1565c0 40%,
      #f4c430 75%,
      #fff2a8 100%
    );

  box-shadow:
    0 0 10px #ffd700,
    0 0 25px rgba(255,215,0,.85),
    0 0 55px rgba(255,215,0,.65),
    0 0 90px rgba(255,215,0,.35);

  border-color:#fff2a8;
}

.btn-daftar:hover:before{
  left:150%;
}

/* ===== LOGIN & LIVECHAT ===== */
.btn-login{

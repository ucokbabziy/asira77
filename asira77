      --text-dim:   #9FD9D2;
      --teal-glow:  rgba(0,255,200,0.65);
    }
  
    /* ── RESET ── */
    *, *::before, *::after { 
      box-sizing: border-box; 
      margin: 0; 
      padding: 0; 
    }
  
    body {
      font-family: 'Rajdhani', sans-serif;
      background: var(--dark);
      min-height: 100vh;
      overflow-x: hidden;
    }
  
    /* ── HERO BACKGROUND ── */
    .hero-bg {
      position: fixed;
      inset: 0;
      z-index: 0;
      background:
        radial-gradient(circle at top, rgba(0,255,200,0.12), transparent 60%),
        linear-gradient(180deg, #021318 0%, #010607 100%);
    }
  
    .hero-bg amp-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: brightness(0.18) saturate(1.2) hue-rotate(140deg);
    }
  
    /* ── GRID SCANLINES ── */
    .scanlines {
      position: fixed;
      inset: 0;
      z-index: 1;
      background-image:
        repeating-linear-gradient(
          0deg,
          transparent,
          transparent 3px,
          rgba(0,255,200,0.03) 3px,
          rgba(0,255,200,0.03) 4px
        );
      pointer-events: none;
    }
  
    /* ── OVERLAY / CENTER ── */
    .overlay {
      position: relative;
      z-index: 10;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px 16px;
    }
  
    /* ── CARD ── */
   .card{
  width:100%;
  max-width:420px;

  background:
    linear-gradient(
      180deg,
      rgba(0,140,255,0.14),
      rgba(0,5,20,0.96)
    );

  border-radius:16px;
  overflow:hidden;

  border:1px solid rgba(0,170,255,.55);

  box-shadow:
    0 0 12px rgba(0,170,255,.45),
    0 0 28px rgba(0,120,255,.35),
    0 0 60px rgba(0,80,255,.22),
    inset 0 0 18px rgba(0,200,255,.10);

  backdrop-filter:blur(8px);

  position:relative;
}

/* efek glow bergerak */
.card:before{
  content:'';
  position:absolute;
  inset:-2px;

  background:linear-gradient(
    135deg,
    transparent,
    rgba(0,255,255,.22),
    rgba(0,140,255,.35),
    transparent
  );

  opacity:.9;
  animation:neonPulse 2.8s infinite ease-in-out;
  pointer-events:none;
}

@keyframes neonPulse{
  0%{
    opacity:.45;
    filter:blur(6px);
  }

  50%{
    opacity:1;
    filter:blur(14px);
  }

  100%{
    opacity:.45;
    filter:blur(6px);
  }
}
  
    /* ── TOPBAR ── */
    .topbar {
      height: 58px;
      display: flex;
      align-items: center;
      justify-content: center;
      background:
        linear-gradient(
          90deg,
          #03191d,
          #062a30,
          #03191d
        );
      border-bottom: 1px solid var(--border);
      position: relative;
    }
  
    .topbar img {
      height: 50px;
      position: relative;
      z-index: 1;
      filter:
        drop-shadow(0 0 5px #00ffe1)
        drop-shadow(0 0 15px rgba(0,255,200,0.5));
    }
  
    .banner{
    position:relative;
    overflow:hidden;

    border-top:4px double #00ffe1;
    border-bottom:4px double #00ffe1;

    background:linear-gradient(
        90deg,
        rgba(0,15,35,.92),
        rgba(0,70,140,.35),
        rgba(0,15,35,.92)
    );

    box-shadow:
        0 0 12px rgba(0,255,225,.45),
        0 0 28px rgba(0,140,255,.35),
        inset 0 0 18px rgba(0,255,255,.12);

    animation:bannerGlow 3s infinite ease-in-out;
}

/* glow luar */
.banner::before{
    content:'';
    position:absolute;
    inset:-2px;

    background:linear-gradient(
        130deg,
        transparent,
        rgba(0,255,255,.35),
        rgba(0,140,255,.55),
        rgba(0,255,225,.35),
        transparent
    );

    opacity:.85;
    filter:blur(14px);

    animation:neonMove 4s linear infinite;

    pointer-events:none;
}

/* shine berjalan */
.banner::after{
    content:'';
    position:absolute;
    top:-40%;
    left:-140%;

    width:70%;
    height:220%;

    background:linear-gradient(
        90deg,
        transparent,
        rgba(255,255,255,.28),
        rgba(0,255,255,.45),
        transparent
    );

    transform:rotate(22deg);

    animation:bannerShine 3.8s infinite;

    pointer-events:none;
}

/* animasi glow */
@keyframes bannerGlow{
    0%,100%{
        box-shadow:
            0 0 10px rgba(0,255,225,.35),
            0 0 22px rgba(0,120,255,.25),
            inset 0 0 14px rgba(0,255,255,.08);
    }

    50%{
        box-shadow:
            0 0 18px rgba(0,255,225,.95),
            0 0 45px rgba(0,140,255,.75),
            0 0 85px rgba(0,200,255,.45),
            inset 0 0 24px rgba(0,255,255,.18);
    }
}

/* glow bergerak */
@keyframes neonMove{
    0%{
        transform:translateX(-40%) scale(1);
    }
    50%{
        transform:translateX(20%) scale(1.05);
    }
    100%{
        transform:translateX(-40%) scale(1);
    }
}

/* efek sapuan cahaya */
@keyframes bannerShine{
    0%{
        left:-140%;
    }
    100%{
        left:180%;
    }
}
  
    .banner img {
